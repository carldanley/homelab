{% set opSecretPath = "op://homelab kubernetes/talos" %}
---
machine:
  type: controlplane
  ca:
    crt: {{ opSecretPath }}/machine-ca-crt
    key: {{ opSecretPath }}/machine-ca-key
cluster:
  ca:
    crt: {{ opSecretPath }}/cluster-ca-crt
    key: {{ opSecretPath }}/cluster-ca-key
  aggregatorCA:
    crt: {{ opSecretPath }}/cluster-aggregator-ca-crt
    key: {{ opSecretPath }}/cluster-aggregator-ca-key
  apiServer:
    image: registry.k8s.io/kube-apiserver:{{ ENV.KUBERNETES_VERSION }}
    extraArgs:
      enable-aggregator-routing: true
    certSANs:
      - 127.0.0.1
      - 10.40.1.250
    disablePodSecurityPolicy: true
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:{{ ENV.KUBERNETES_VERSION }}
    extraArgs:
      bind-address: 0.0.0.0
  coreDNS:
    disabled: true
  etcd:
    advertisedSubnets:
      - 10.40.1.0/24
    ca:
      crt: {{ opSecretPath }}/cluster-etcd-ca-crt
      key: {{ opSecretPath }}/cluster-etcd-ca-key
    extraArgs:
      listen-metrics-urls: "http://0.0.0.0:2381"
  extraManifests:
    - # renovate: datasource=github-releases depName=kubernetes-sigs/gateway-api
      https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.2/experimental-install.yaml
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:{{ ENV.KUBERNETES_VERSION }}
  secretboxEncryptionSecret: {{ opSecretPath }}/cluster-secretbox-encryption-secret
  scheduler:
    image: registry.k8s.io/kube-scheduler:{{ ENV.KUBERNETES_VERSION }}
    extraArgs:
      bind-address: 0.0.0.0
  serviceAccount:
    key: {{ opSecretPath }}/cluster-service-account-key
---
# Talos 1.14 makes the control-plane role label and NoSchedule taint explicit
# once KubeNodeConfig is used (they were implicit in v1alpha1). The label must
# stay: Cilium's BGP peering selects on it. No taint is listed on purpose, which
# is the same as the former cluster.allowSchedulingOnControlPlanes: true.
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
  topology.kubernetes.io/zone: controlplane
---
# Talos API access from in-cluster workloads (flux, tuppr, ARC), formerly
# machine.features.kubernetesTalosAPIAccess.
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
  - os:operator
allowedKubernetesNamespaces:
  - actions-runner-system
  - flux-system
  - system-upgrade
