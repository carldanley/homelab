{% set opSecretPath = "op://homelab kubernetes/talos" %}
---
version: v1alpha1
debug: false
persist: true
machine:
  token: {{ opSecretPath }}/machine-token
  ca:
    crt: {{ opSecretPath }}/machine-ca-crt
  certSANs:
    - 127.0.0.1
    - 10.40.1.250
  features:
    rbac: true
    stableHostname: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
  kubelet:
    # Stays in v1alpha1 for now: a KubeletConfig document is mutually exclusive
    # with every machine.kubelet field, and disableManifestsDirectory has no
    # document equivalent in Talos 1.14.
    image: ghcr.io/siderolabs/kubelet:{{ ENV.KUBERNETES_VERSION }}
    extraConfig:
      serializeImagePulls: false
      imageGCHighThresholdPercent: 65
      imageGCLowThresholdPercent: 55
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
cluster:
  ca:
    crt: {{ opSecretPath }}/cluster-ca-crt
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service:
        disabled: false
  id: {{ opSecretPath }}/cluster-id
  secret: {{ opSecretPath }}/cluster-secret
  token: {{ opSecretPath }}/cluster-token
---
# Talos 1.14: machine.sysctls, machine.kernel and machine.udev are deprecated in
# favor of these documents. Values are unchanged; a node file may carry its own
# SysctlConfig to override single keys (the patch tool merges the params map).
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_watches: "1048576"   # Watchdog
  fs.inotify.max_user_instances: "8192"    # Watchdog
  net.core.default_qdisc: "fq"             # 10Gb/s
  net.core.rmem_max: "67108864"            # 10Gb/s | Cloudflared / QUIC
  net.core.wmem_max: "67108864"            # 10Gb/s | Cloudflared / QUIC
  net.ipv4.ping_group_range: "0 2147483647" # Ping non-root
  net.ipv4.tcp_congestion_control: "bbr"   # 10Gb/s
  net.ipv4.tcp_fastopen: "3"               # Send and accept data in the opening SYN packet
  net.ipv4.tcp_mtu_probing: "1"            # 10Gb/s | Jumbo frames
  net.ipv4.tcp_notsent_lowat: "131072"     # 10Gb/s
  net.ipv4.tcp_rmem: "4096 87380 33554432" # 10Gb/s
  net.ipv4.tcp_slow_start_after_idle: "0"  # 10Gb/s
  net.ipv4.tcp_wmem: "4096 65536 33554432" # 10Gb/s
  net.ipv4.tcp_window_scaling: "1"         # 10Gb/s
  sunrpc.tcp_slot_table_entries: "128"     # 10Gb/s | NFS
  sunrpc.tcp_max_slot_table_entries: "128" # 10Gb/s | NFS
  user.max_user_namespaces: "11255"        # User Namespaces
  vm.nr_hugepages: "3072"                  # PostgreSQL: 2Gi databases/postgres + 4Gi uxi/uxi-postgres
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: UdevRulesConfig
rules:
  - # GPU
    SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"
---
# Talos 1.14: machine.nodeLabels is deprecated in favor of KubeNodeConfig. Role
# and node files add their own labels; the patch tool merges the maps.
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.40.1.0/24
labels:
  topology.kubernetes.io/region: homelab
---
# Talos 1.14: machine.features.kubePrism, machine.features.hostDNS,
# machine.network.nameservers and machine.network.disableSearchDomain are
# deprecated in favor of these two documents. Values are unchanged.
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.40.1.1
searchDomains:
  disableDefault: true
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false
  resolveMemberNames: true
---
# Talos 1.14: cluster.clusterName, cluster.controlPlane.endpoint and
# cluster.network are deprecated in favor of these documents. No CNI document
# is declared on purpose: Cilium is installed by Flux, so no Talos-managed CNI.
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: {{ ENV.CLUSTER_NAME }}
endpoint: https://10.40.1.250:6443
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 172.22.0.0/16
serviceSubnets:
  - 172.23.0.0/16
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  # Keep all nodes on the same leap-smear policy. A noisy pool fallback caused
  # recurring Ceph monitor clock skew; retry these sources if boot DNS is late.
  servers:
    - time1.google.com
    - time2.google.com
    - time3.google.com
    - time4.google.com
---
# Replaces the deprecated machine.files entry for /etc/cri/conf.d (Talos 1.14):
# fragments are merged into the CRI containerd config in name order.
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: 20-customization
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
---
# Replaces the deprecated machine.files entry for /etc/nfsmount.conf (Talos 1.14).
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.1
  hard=True
  nconnect=16
  noatime=True
  rsize=1048576
  wsize=1048576
