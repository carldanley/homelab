      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (band) (increase(unbound_worker_knockouts_total{player_job=~\"$job\",band=~\"$band\"}[$__range])) / (sum by (band) (increase(unbound_worker_played_seconds_total{player_job=~\"$job\",band=~\"$band\"}[$__range])) / 3600)", "legendFormat": "{{band}}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "displayName": "${__field.labels.band}", "unit": "none", "decimals": 2, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "namePlacement": "top", "sizing": "manual", "maxVizHeight": 36, "text": { "titleSize": 14, "valueSize": 18 }, "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    },
