      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (attacker) (increase(unbound_worker_strikes_total{strike=\"magic\",outcome=\"resisted\",player_job=~\"$job|none\"}[$__range])) / sum by (attacker) (increase(unbound_worker_strikes_total{strike=\"magic\",player_job=~\"$job|none\"}[$__range]))", "legendFormat": "{{attacker}}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "displayName": "${__field.labels.attacker}", "unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "namePlacement": "top", "sizing": "manual", "maxVizHeight": 36, "text": { "titleSize": 14, "valueSize": 18 }, "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    },
    {
      "id": 48,
      "type": "bargauge",
      "title": "Knockouts per played hour, by level band",
