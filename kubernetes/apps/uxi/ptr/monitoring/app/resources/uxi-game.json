      ],
      "fieldConfig": { "defaults": { "displayName": "${__field.labels.zone}", "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "namePlacement": "top", "sizing": "manual", "maxVizHeight": 36, "text": { "titleSize": 14, "valueSize": 18 }, "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
