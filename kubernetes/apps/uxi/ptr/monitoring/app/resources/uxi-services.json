{
  "uid": "uxi-services",
  "title": "UnboundXI — Services",
  "description": "The five services' plumbing: up and ready, the worker's tick, the gateway's clients, the state service's flushes, the bus, the API's pool, content and scripts (docs/spec/deployment.md, \"Probes and metrics\").",
  "tags": ["unboundxi", "services"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    { "title": "Game", "type": "link", "url": "/d/uxi-game", "icon": "dashboard", "keepTime": true }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health — now",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scraped and answering",
      "description": "Each service's probe listener answered Prometheus's last scrape.",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "min by (app_kubernetes_io_component) (up{namespace=\"uxi-ptr\",app_kubernetes_io_component=~\"state|api|gateway|worker|zone-worker|social\"})", "legendFormat": "{{app_kubernetes_io_component}}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ready and connected",
      "description": "Each process's own view of its peers: one while connected or ready, zero while not.",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "min(unbound_api_ready)", "legendFormat": "api ready", "instant": true },
        { "refId": "B", "expr": "min(unbound_gateway_state_ready)", "legendFormat": "gateway → state", "instant": true },
        { "refId": "C", "expr": "min(unbound_gateway_api_ready)", "legendFormat": "gateway → api", "instant": true },
        { "refId": "D", "expr": "min(unbound_worker_state_ready)", "legendFormat": "worker → state", "instant": true },
        { "refId": "E", "expr": "min(unbound_social_link_connected)", "legendFormat": "social → bus", "instant": true },
        { "refId": "F", "expr": "min(unbound_state_link_connected)", "legendFormat": "state → bus", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [ { "type": "value", "options": { "0": { "text": "NO", "color": "red" }, "1": { "text": "YES", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical" }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Worker",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tick length p50, p95, p99 (budget 0.4 s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(unbound_worker_tick_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(unbound_worker_tick_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(unbound_worker_tick_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 0.4 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Batch acknowledgement p95 and longest",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(unbound_worker_batch_ack_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "max(unbound_worker_batch_ack_seconds_max)", "legendFormat": "longest since start" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sessions, zones and groups held",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(unbound_worker_sessions)", "legendFormat": "sessions" },
        { "refId": "B", "expr": "sum(unbound_worker_zones)", "legendFormat": "zones" },
        { "refId": "C", "expr": "sum(unbound_worker_groups)", "legendFormat": "groups" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Motion samples refused per minute, by reason",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(unbound_worker_motion_rejected_total[$__rate_interval])) * 60", "legendFormat": "{{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Mob path plans and sight rays per second",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(unbound_worker_mob_path_plans_total[$__rate_interval]))", "legendFormat": "paths {{outcome}}" },
        { "refId": "B", "expr": "sum by (outcome) (rate(unbound_worker_mob_sight_rays_total[$__rate_interval]))", "legendFormat": "rays {{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Gateway output shed",
      "description": "What the byte bound on a gateway's output cost: datagrams dropped and sessions closed alone, per minute.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(unbound_worker_gateway_datagrams_shed_total[$__rate_interval])) * 60", "legendFormat": "datagrams shed" },
        { "refId": "B", "expr": "sum(rate(unbound_worker_gateway_sessions_closed_total[$__rate_interval])) * 60", "legendFormat": "sessions closed" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Gateway",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Client round trip p50 and p95",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(unbound_gateway_client_rtt_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(unbound_gateway_client_rtt_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Client packet loss",
      "description": "Share of QUIC packets sent on admitted connections that were declared lost, clamped at 100 %. The axis runs from 0 to at least 1 %, wider only when loss is: with no loss at all, Grafana would otherwise range a flat zero line over 0 to 100 in raw units, 10,000 %.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "clamp_max(sum(rate(unbound_gateway_client_packets_lost_total[$__rate_interval])) / sum(rate(unbound_gateway_client_packets_sent_total[$__rate_interval])), 1)", "legendFormat": "lost share" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "custom": { "axisSoftMax": 0.01 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Pauses, zone-change waits and dropped worker messages",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(unbound_gateway_sessions_paused)", "legendFormat": "paused now" },
        { "refId": "B", "expr": "sum(unbound_gateway_zone_change_waits)", "legendFormat": "zone-change waits now" },
        { "refId": "C", "expr": "sum by (reason) (rate(unbound_gateway_worker_messages_dropped_total[$__rate_interval])) * 60", "legendFormat": "dropped/min {{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 30,
      "type": "row",
      "title": "State service and API",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Flush age and oldest durable proposal",
      "description": "The lag a restart of the state service would lose, and how long the oldest unresolved durable proposal has waited.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "max(unbound_state_flush_age_seconds)", "legendFormat": "flush age" },
        { "refId": "B", "expr": "max(unbound_state_durable_oldest_seconds)", "legendFormat": "oldest durable" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Batches, refusals and flush failures per minute",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(unbound_state_batches_total[$__rate_interval])) * 60", "legendFormat": "batches" },
        { "refId": "B", "expr": "sum(rate(unbound_state_batches_refused_total[$__rate_interval])) * 60", "legendFormat": "refused" },
        { "refId": "C", "expr": "sum(rate(unbound_state_flush_failures_total[$__rate_interval])) * 60", "legendFormat": "flush failures" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Zones open and ownerless; API pool",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "max(unbound_state_zones_open)", "legendFormat": "zones open" },
        { "refId": "B", "expr": "max(unbound_state_zones_ownerless)", "legendFormat": "zones ownerless" },
        { "refId": "C", "expr": "sum(unbound_api_pool_connections)", "legendFormat": "API pool connections" },
        { "refId": "D", "expr": "sum(unbound_api_pool_idle)", "legendFormat": "API pool idle" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Bus and social",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Bytes carried per second, by service and lane",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (service, lane) (rate({__name__=~\"unbound_.*_lane_bytes_total\", direction=\"sent\"}[$__rate_interval])) > 0", "legendFormat": "{{service}} → {{lane}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Bus gaps per minute, by service",
      "description": "Messages lost on a subscription: what was lost there is lost.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate({__name__=~\"unbound_.*_bus_gaps_total\"}[$__rate_interval])) * 60", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Social delivery p95 and store errors",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(unbound_social_delivery_seconds_bucket[$__rate_interval])))", "legendFormat": "delivery p95" },
        { "refId": "B", "expr": "sum(rate(unbound_social_store_errors_total[$__rate_interval])) * 60", "legendFormat": "store errors/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [
        { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [ { "id": "unit", "value": "none" }, { "id": "custom.axisPlacement", "value": "right" } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Content and scripts",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "panels": []
    },
    {
      "id": 51,
      "type": "stat",
      "title": "Content loaded",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "max(unbound_content_zones_loaded)", "legendFormat": "zones loaded", "instant": true },
        { "refId": "B", "expr": "max(unbound_content_files)", "legendFormat": "files", "instant": true },
        { "refId": "C", "expr": "max(unbound_content_items)", "legendFormat": "items", "instant": true },
        { "refId": "D", "expr": "max(unbound_script_memory_bytes)", "legendFormat": "Lua memory", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [
        { "matcher": { "id": "byFrameRefID", "options": "D" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
      ] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal" }
    },
    {
      "id": 52,
      "type": "bargauge",
      "title": "Slowest zone loads",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sort_desc(topk(10, max by (slug) (unbound_content_zone_load_seconds)))", "legendFormat": "{{slug}}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "displayName": "${__field.labels.slug}", "unit": "s", "decimals": 2, "min": 0, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "namePlacement": "top", "sizing": "manual", "maxVizHeight": 36, "text": { "titleSize": 14, "valueSize": 18 }, "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    },
    {
      "id": 53,
      "type": "table",
      "title": "Busiest and failing script hooks in range",
      "description": "Every hook called over the time range, by file: calls, errors and seconds spent.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "topk(20, sum by (file, hook) (increase(unbound_script_calls_total[$__range])))", "instant": true, "format": "table" },
        { "refId": "B", "expr": "sum by (file, hook) (increase(unbound_script_errors_total[$__range]))", "instant": true, "format": "table" },
        { "refId": "C", "expr": "sum by (file, hook) (increase(unbound_script_seconds_total[$__range]))", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [ { "id": "displayName", "value": "calls" } ] },
        { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [ { "id": "displayName", "value": "errors" } ] },
        { "matcher": { "id": "byName", "options": "Value #C" }, "properties": [ { "id": "displayName", "value": "seconds" }, { "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 } ] }
      ] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "filterByValue", "options": { "type": "exclude", "match": "any", "filters": [ { "fieldName": "Value #A", "config": { "id": "isNull", "options": {} } } ] } },
        { "id": "organize", "options": { "excludeByName": { "Time": true } } },
        { "id": "sortBy", "options": { "sort": [ { "field": "Value #A", "desc": true } ] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}
